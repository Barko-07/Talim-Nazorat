# Copy to /etc/individ/individ.env on the server (owner root:individ, chmod 640).
# NEVER commit the real file. Generate secrets on the server:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"                         -> SECRET_KEY
#   python3 -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())" -> DATA_ENCRYPTION_KEY
# Back up DATA_ENCRYPTION_KEY offline: without it encrypted columns cannot be read.

INDIVID_ENV=production
SECRET_KEY=
DATA_ENCRYPTION_KEY=
DATABASE_URL=postgresql+psycopg://individ_app:CHANGE_ME@127.0.0.1:5432/individ

PUBLIC_BASE_URL=https://individ.uz
# Same-origin deployment needs no extra origins. List only https:// origins, never *.
ALLOWED_ORIGINS=

# Mail for one-time codes (password reset/change) - use your provider's SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@individ.uz

# Optional: HTTPS webhook that receives security alerts (e.g. a Telegram relay).
ALERT_WEBHOOK_URL=

# Optional: only these addresses/networks may use /api/admin (e.g. your office IP).
ADMIN_IP_ALLOWLIST=

# Defaults shown; change only with a reason.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_PER_MINUTE=60
API_PER_MINUTE=120
API_IP_PER_MINUTE=3000
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
# Optional: roles that must also set up an authenticator app (e.g. SUPER_ADMIN).
# Empty = every login is confirmed with an emailed code only.
MFA_REQUIRED_ROLES=
TRUSTED_PROXIES=127.0.0.1,::1
